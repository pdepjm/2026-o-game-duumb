import wollok.game.*

import jugador.*
import juego.*

program JohnParadigmas { 
	game.title("Super mega color blast, la venganza de los colores. Ahora en 3D y 4K Exclusivo estreno solo en wollok game 2027")
	game.height(11)
	game.width(10)
	game.cellSize(100)
	game.boardGround("background3.png")

	juego.iniciar()

	// movimiento babosa verde (WASD)
	keyboard.w().onPressDo({ jugadorVerde.moverHacia(arriba) })
    keyboard.s().onPressDo({ jugadorVerde.moverHacia(abajo) })
    keyboard.a().onPressDo({ jugadorVerde.moverHacia(izquierda) })
    keyboard.d().onPressDo({ jugadorVerde.moverHacia(derecha) })
    
    // movimiento babosa azul (flechas)
    keyboard.up().onPressDo({ jugadorAzul.moverHacia(arriba) })
    keyboard.down().onPressDo({ jugadorAzul.moverHacia(abajo) })
    keyboard.left().onPressDo({ jugadorAzul.moverHacia(izquierda) })
    keyboard.right().onPressDo({ jugadorAzul.moverHacia(derecha) })
	
	game.start()
}


